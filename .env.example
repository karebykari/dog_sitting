# Added automatically when an Upstash Redis database is connected to Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Create a long private password for /admin.html.
OWNER_ADMIN_KEY=

# Create a sending-only API key at https://resend.com/api-keys.
RESEND_API_KEY=

# Optional overrides. These defaults are already used by the website.
BOOKING_NOTIFICATION_EMAIL=karebykari@gmail.com
BOOKING_FROM_EMAIL=Kare By Kari <onboarding@resend.dev>
